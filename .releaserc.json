{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "parserOpts": {
          "noteKeywords": ["BREAKING CHANGE", "BREAKING CHANGES", "RELEASE NOTES"]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "User-facing improvements"
            },
            {
              "type": "fix",
              "section": "Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "refactor",
              "section": "Code cleanup"
            },
            {
              "type": "build",
              "section": "Build and release"
            },
            {
              "type": "ci",
              "section": "Build and release"
            },
            {
              "type": "chore",
              "section": "Maintenance"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "style",
              "hidden": true
            }
          ]
        },
        "parserOpts": {
          "noteKeywords": ["BREAKING CHANGE", "BREAKING CHANGES", "RELEASE NOTES"]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python3 .github/scripts/bump_version.py ${nextRelease.version} && cd custom_components/dmi && zip -r ../../dmi.zip ."
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "pyproject.toml",
          "custom_components/**/manifest.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dmi.zip",
            "label": "dmi.zip"
          }
        ]
      }
    ]
  ]
}
